{
  // Static assets only: `npm run build` exports the site to out/.
  "name": "zkvot-landing",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  // Custom domains: wrangler creates their DNS records on deploy.
  "routes": [
    { "pattern": "zkvot.io", "custom_domain": true },
    { "pattern": "www.zkvot.io", "custom_domain": true }
  ]
}
